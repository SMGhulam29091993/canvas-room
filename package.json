    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.7.3",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
